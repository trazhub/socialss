[Unit]
Description=TrazLinks web app
After=network.target

[Service]
Type=simple
User=trazlinks
Group=trazlinks
WorkingDirectory=/opt/trazlinks/builder-app
EnvironmentFile=/opt/trazlinks/builder-app/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
